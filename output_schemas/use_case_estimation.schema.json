{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UseCaseEstimationOutput",
  "description": "Generate actual JSON data conforming to this schema, not the schema itself. The output must include real use case estimation values in the 'rows' array.",
  "type": "object",
  "properties": {
    "technique": {
      "type": "string",
      "enum": ["Use Case Estimation"]
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "useCaseName": { "type": "string" },
          "complexity": { "type": "string", "enum": ["S", "M", "L"] },
          "weight": { "type": "integer", "minimum": 0 },
          "effortEstimateHours": { "type": "integer", "minimum": 0 },
          "riskLevel": { "type": "string", "enum": ["Low", "Medium", "High"] },
          "classification": { "type": "string" },
          "effortType": { "type": "string", "enum": ["Low", "Medium", "High"] },
          "personDays": { "type": "integer", "minimum": 0 }
        },
        "required": [
          "useCaseName",
          "complexity",
          "weight",
          "effortEstimateHours",
          "riskLevel",
          "classification",
          "effortType",
          "personDays"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["technique", "rows"],
  "additionalProperties": false
}
