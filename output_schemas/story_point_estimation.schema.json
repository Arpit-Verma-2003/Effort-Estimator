{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StoryPointEstimationOutput",
  "description": "Generate actual JSON data conforming to this schema, not the schema itself. The output must include real use case estimation values in the 'rows' array.",
  "type": "object",
  "properties": {
    "technique": {
      "type": "string",
      "enum": ["Story Point Estimation"]
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "epic": { "type": "string" },
          "userStory": { "type": "string" },
          "storyPoints": { "type": "integer", "minimum": 0 },
          "complexity": { "type": "string", "enum": ["Low", "Medium", "High"] },
          "classification": { "type": "string" },
          "riskLevel": { "type": "string", "enum": ["Low", "Medium", "High"] },
          "effortType": { "type": "string", "enum": ["Low", "Medium", "High"] }
        },
        "required": [
          "epic",
          "userStory",
          "storyPoints",
          "complexity",
          "classification",
          "riskLevel",
          "effortType"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["technique", "rows"],
  "additionalProperties": false
}
